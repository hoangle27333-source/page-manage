# Page Manage — Content Automation & Video Remix Studio
# Environment Configuration Template

NODE_ENV=development
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Supabase Database & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
DATABASE_POOLER_URL=postgresql://postgres.your-project:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_MEDIA_BUCKET=media

# Redis & BullMQ Worker Queue
REDIS_URL=redis://127.0.0.1:6379

# Meta Graph API (Facebook / Instagram)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
META_WEBHOOK_APP_SECRET=your-webhook-app-secret
TOKEN_ENCRYPTION_KEY=32_bytes_hex_or_base64_encryption_key

# AI Providers & Budget
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key
GEMINI_TEXT_MODEL=gemini-2.0-flash
OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key
AI_MONTHLY_BUDGET_VND=5000000
AI_PRICE_INPUT_PER_M_USD=0.075
AI_PRICE_OUTPUT_PER_M_USD=0.30
USD_TO_VND_RATE=25400

# Video Remix & Subtitle Engines
VIDEO_RENDERER=ffmpeg
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
FFPROBE_PATH=/opt/homebrew/bin/ffprobe
YTDLP_PATH=/opt/homebrew/bin/yt-dlp
BRAND_LOGO_URL=

# On-Screen Text & Subtitle OCR Service (Python FastAPI)
ON_SCREEN_TEXT_ENGINE=paddleocr
PADDLEOCR_SERVICE_URL=http://127.0.0.1:8080
PADDLEOCR_TIMEOUT_MS=60000
PADDLEOCR_LANG=ch
PADDLEOCR_SAMPLE_INTERVAL_SEC=1.0
PADDLEOCR_MAX_SAMPLE_FRAMES=10
PADDLEOCR_FRAME_WIDTH_LIMIT=720

# Voice Alignment & TTS Pipeline
VOICE_PIPELINE_URL=http://127.0.0.1:8081
VOICE_PIPELINE_TIMEOUT_MS=60000
VOICE_ALIGNMENT_PROVIDER=voice_pipeline
TTS_PROVIDER=google
GOOGLE_TTS_API_KEY=your-google-tts-key
TTS_VOICE_VI=vi-VN-Standard-A
TTS_SPEAKING_RATE=1.0

# HeyGen AI Video Dubbing
HEYGEN_API_KEY=your-heygen-key
HEYGEN_API_BASE_URL=https://api.heygen.com

# ComfyUI Image Inpainting / Background Removal
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT_MS=120000
REMBG_URL=http://127.0.0.1:7000
